---
layout: layout.njk
title: Preferences
permalink: /preferences/
---
{% set defaultVersion = translations | selectattr("readerDefault") | first %}
{% set embedded = translations | selectattr("embedded") | first %}
<h1>Preferences</h1>
<p>These are saved in this browser. Pages embed {{ embedded.name }} so they can be read with scripts off. {{ defaultVersion.name }} is the default when that text is on the server.</p>
<form id="prefs-form">
  <p><label>Bible version
    <select id="bibleVersion" name="bibleVersion">
      {% for version in translations %}
      <option value="{{ version.id }}"{% if version.readerDefault %} selected{% endif %}{% if version.copyrighted %} data-copyright="1"{% endif %}>{{ version.name }}</option>
      {% endfor %}
    </select>
  </label></p>
  <p><label>Psalm text in the office
    <select id="useBCPDO" name="useBCPDO">
      <option value="false">Bible</option>
      <option value="true">Book of Common Prayer psalter</option>
    </select>
  </label></p>
  <p><label>Office rite for the collect
    <select id="prayerRite" name="prayerRite">
      <option value="false">Rite II</option>
      <option value="true">Rite I</option>
    </select>
  </label></p>
  <p><label>When to show the morning office
    <select id="prayerDayTime" name="prayerDayTime">
      <option value="true">Morning is the stored choice</option>
      <option value="false">Evening is the stored choice</option>
    </select>
  </label></p>
  <p><label><input id="prayerAll" name="prayerAll" type="checkbox"> All readings for the day, and use the stored morning or evening choice instead of the time of day</label></p>
  <p><label>Sunday lectionary named first
    <select id="lectionaryType" name="lectionaryType">
      <option value="false">Revised Common Lectionary</option>
      <option value="true">1979 Lectionary</option>
    </select>
  </label></p>
  <p><label>Text size <input id="fontSize" name="fontSize" type="number" min="12" max="28" value="14"></label></p>
  <p><button type="submit">Save</button></p>
</form>
{% for language in catalog.languages %}
{% if language.note %}
<p>{{ language.note }}
{% for page in language.pages %}
<a href="{{ page.href }}">{{ page.title }}</a>{% if not loop.last %} &nbsp;|&nbsp; {% endif %}
{% endfor %}
</p>
{% endif %}
{% endfor %}
