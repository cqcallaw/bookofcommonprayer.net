
RewriteOptions inherit
#
# QuickShell ReWrite Mechanism
# If this doesn't immediately work, you may need to check the httpd.conf|apache2.conf file to make
# sure that the /var/www/(html)/ directory has "AllowOverride All" set as they are often set to "None"
# on clean installs.  Most web hosts have it set to "All" 
#
 RewriteEngine On
 
 #Force www:
 RewriteCond %{HTTP_HOST} ^bookofcommonprayer.net [NC]
RewriteCond %{REQUEST_URI} !^/[0-9]+\..+\.cpaneldcv$
RewriteCond %{REQUEST_URI} !^/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
 RewriteRule ^(.*)$ http://www.bookofcommonprayer.net/$1 [L,R=301,NC]

 RewriteCond %{REQUEST_FILENAME} !-f
 RewriteCond %{REQUEST_FILENAME} !-d
 RewriteCond %{REQUEST_FILENAME} !-l
RewriteCond %{REQUEST_URI} !^/[0-9]+\..+\.cpaneldcv$
RewriteCond %{REQUEST_URI} !^/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
 RewriteRule ^(.*)$ index.php?id=$1 [L,QSA]
 # REWRITE ANYTHING NOT IN THE PUBLIC FOLDER TO 'FORBIDDEN'
 # SINCE ANYTHING IN THE PUBLIC FOLDER CAN BE VIEWED VIA 'VIEW-SOURCE' ANYWAY
 # BUT WE STILL WANT TO DENY ACCESS TO THE NON RENDERED VIEW JUST BECAUSE
 # WE THAT'S THE KIND OF PEOPLE WE ARE
RewriteCond %{REQUEST_URI} !^/[0-9]+\..+\.cpaneldcv$
RewriteCond %{REQUEST_URI} !^/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
 RewriteRule \.phtml index.php?id=forbidden [L,QSA]
RewriteCond %{REQUEST_URI} !^/[0-9]+\..+\.cpaneldcv$
RewriteCond %{REQUEST_URI} !^/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
 RewriteRule ^controllers/(.*) index.php?id=forbidden [L,QSA]
RewriteCond %{REQUEST_URI} !^/[0-9]+\..+\.cpaneldcv$
RewriteCond %{REQUEST_URI} !^/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
 RewriteRule ^system/(.*) index.php?id=forbidden [L,QSA]
RewriteCond %{REQUEST_URI} !^/[0-9]+\..+\.cpaneldcv$
RewriteCond %{REQUEST_URI} !^/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
 RewriteRule ^vendor/(.*) index.php?id=forbidden [L,QSA]

 Options -Indexes
 ErrorDocument 403 /BCP/index.php?id=forbidden
RewriteCond %{HTTP_HOST} ^m1\.bookofcommonprayer\.net$ [OR]
RewriteCond %{HTTP_HOST} ^www\.m1\.bookofcommonprayer\.net$
RewriteCond %{REQUEST_URI} !^/[0-9]+\..+\.cpaneldcv$
RewriteCond %{REQUEST_URI} !^/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteRule ^/?$ "http\:\/\/www\.bookofcommonprayer\.net" [R=301,L]

