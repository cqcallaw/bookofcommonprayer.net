<em>Psalm</em>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;   <a target=_blank href="<?php echo SERVER;?>#/search/display/Psalm 22:1-21">22:1-21</a>,   <em>or</em> <a target=_blank href="<?php echo SERVER;?>#/search/display/Psalm 22:1-11">22:1-11</a> <br>

