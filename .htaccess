RewriteEngine On

<if "%{QUERY_STRING} =~ /^fbclid=/">
RewriteRule  .  %{REQUEST_URI}?   [R=301,L]
</if>

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^bookofcommonprayer.net [NC]
RewriteRule ^(.*)$ http://www.bookofcommonprayer.net/$1 [L,R=301,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-l

RewriteRule ^(.*)$ index.php
# REWRITE ANYTHING NOT IN THE PUBLIC FOLDER TO 'FORBIDDEN'
# SINCE ANYTHING IN THE PUBLIC FOLDER CAN BE VIEWED VIA 'VIEW-SOURCE' ANYWAY
# BUT WE STILL WANT TO DENY ACCESS TO THE NON RENDERED VIEW JUST BECAUSE
# WE THAT'S THE KIND OF PEOPLE WE ARE
RewriteRule \.phtml index.php?id=forbidden [L,QSA]
RewriteRule ^public/views/(.*) index.php?id=forbidden [L,QSA]
RewriteRule ^controllers/(.*) index.php?id=forbidden [L,QSA]
RewriteRule ^system/(.*) index.php?id=forbidden [L,QSA]
RewriteRule ^vendor/(.*) index.php?id=forbidden [L,QSA]
RewriteRule ^docker/ - [F,L]
RewriteRule ^orig/ - [F,L]
RewriteRule ^\.git - [F,L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php74” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
